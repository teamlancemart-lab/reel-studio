# reel-studio environment. Every variable either service reads, with a dummy value.
#
# Local:   cp .env.example .env       (repo root; `npm run dev` in service/ loads it)
#          web reads its own file:    echo "NEXT_PUBLIC_SERVICE_URL=http://localhost:8080" > web/.env.local
# Railway: set the SERVICE block in Railway → Variables. Values that differ in
#          production are noted on each line.
# Vercel:  set the WEB block in Vercel → Settings → Environment Variables.
#
# Never commit a filled-in copy. .gitignore ignores every .env* except this file.

# ============================================================== WEB (Vercel, /web)
# The only variable /web reads. No GCP credentials on Vercel, ever.

# Base URL of the render service; the dashboard calls it from the browser.
# Local: http://localhost:8080   Production: https://reel-studio-production-18ec.up.railway.app
NEXT_PUBLIC_SERVICE_URL=http://localhost:8080

# ========================================================= SERVICE (Railway, /service)

# Port the Express server listens on. Railway injects its own; the Dockerfile defaults to 8080.
PORT=8080

# Where jobs, uploads, ledgers and renders are written. Relative paths resolve from service/.
# Local: ./data (gitignored)   Production: /data (mount a Railway volume there, or history
# is wiped on every deploy).
DATA_DIR=./data

# CORS origin allowed to call the service. * is fine locally.
# Production: https://reel-studio-omega.vercel.app
ALLOWED_ORIGIN=*

# Shared secret for writes. When set, every non-GET request needs it in the x-studio-key
# header (the dashboard asks for it once and keeps it in localStorage). Leave empty
# locally for an open service. Production: set a long random string.
STUDIO_ACCESS_KEY=

# Python with Pillow 11 for the overlay renderer (all text overlays are Pillow PNGs).
# Local: the venv from the README, .venv/bin/python3 (relative to service/).
# Production: /opt/venv/bin/python3 (the Dockerfile sets it; do not set on Railway).
PYTHON_BIN=.venv/bin/python3

# ---- Vertex AI (Gemini text/vision, Gemini image, Veo)

# GCP project that owns Vertex AI. Dummy value here; the real id is in the shared vault.
GCP_PROJECT_ID=your-gcp-project-id

# Vertex region. Veo 3.1 Lite is verified in us-central1.
GCP_LOCATION=us-central1

# The service-account key, base64 of sa.json on one line. The service reads the key ONLY
# from this variable, never from a file path. Generate it from the sa.json at the repo root:
#   macOS: base64 -i sa.json | tr -d '\n'      Linux: base64 -w0 sa.json
# The dummy below decodes to {"type":"service_account"}: /health starts, model calls fail.
GCP_SA_JSON_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50In0=

# Model ids. Defaults shown; change only with a matching cost-model.json rate.
TEXT_MODEL=gemini-2.5-flash
TEXT_LITE_MODEL=gemini-2.5-flash-lite
IMAGE_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-lite-generate-001

# ---- Spend gates

# The paid-video kill switch. Exactly "true" allows Veo calls; anything else blocks every
# paid video call, whatever a job asks for. Keep false locally unless you mean to spend.
# Production (currently): true
GENERATIVE_ENABLED=false

# Interior motion. "2.5d" (default: real photos, parallax, Ken Burns) or exactly "veo"
# (opt-in: QA-gated Veo camera glides on up to 3 hero interiors; also needs
# GENERATIVE_ENABLED=true). Production (currently): veo
INTERIOR_MOTION=2.5d

# ---- Optional overrides. Defaults shown; uncomment only to change them.

# Font directory filled by `npm run fonts`. Default: service/assets/fonts
# FONTS_DIR=assets/fonts
# Location of rules.json, schemas.json, cost-model.json. Default: service/shared, then ../shared
# SHARED_DIR=../shared
# Per-request Vertex timeout, milliseconds.
# VERTEX_TIMEOUT_MS=120000
# Retry backoff schedule for Vertex 429/5xx, milliseconds, comma-separated.
# VERTEX_BACKOFF_MS=8000,20000,45000
