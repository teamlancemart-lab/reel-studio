# ---------------------------------------------------------------- web (Vercel)
# Root Directory: web. This is the ONLY variable /web needs.
# No GCP credentials on Vercel, ever.
NEXT_PUBLIC_SERVICE_URL=https://<your-railway-domain>

# ------------------------------------------------------------ service (Railway)
# Set these in Railway Variables, not in a file.
# Root Directory "/", Dockerfile Path "service/Dockerfile", Volume /data 5GB.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_SA_JSON_B64=          # base64 -i sa.json | tr -d '\n' | pbcopy
TEXT_MODEL=gemini-2.5-flash
TEXT_LITE_MODEL=gemini-2.5-flash-lite
IMAGE_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-lite-generate-001
DATA_DIR=/data
ALLOWED_ORIGIN=           # your Vercel URL; * until you have it
PORT=8080

# The paid-video gate. Stays false until Stage 6. Exactly "true" opens it.
GENERATIVE_ENABLED=false
