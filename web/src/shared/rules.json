  "qa_reject_list": [
    "people_added_or_removed",
    "vehicles_added_or_removed",
    "time_of_day_changed",
    "weather_changed",
    "lights_switched",
    "fire_or_fireplace_added",
    "water_or_pool_added",
    "fireworks_smoke_snow",
    "furniture_changed_moved_added_removed",
    "floor_count_mismatch",
    "window_count_mismatch",
    "door_count_mismatch",
    "balcony_count_mismatch",
    "roof_line_mismatch",
    "door_opens_or_wall_passthrough",
    "text_or_logo_added",
    "last_frame_not_source"
  ],
  "qa_prompt_negative_block": "no people, no vehicles, no animals, no extra windows, no extra floors, no text, no logos, no signage, no lights turning on, no change of time of day or weather, no fire, no water, no fireworks, no new furniture, no moved furniture, the building in the reference image stays exactly as photographed",
  "preflight_rules": [
    {
      "id": "IN_NO_RERA_NEW",
      "stage": "pre_generation",
      "level": "BLOCK",
      "when": "market=in AND (facts.status in [new_launch, under_construction, coming_soon]) AND compliance_context.rera_project is empty",
      "message": "New or under-construction project cannot be advertised without a RERA registration number (RERA s.3)."
    },
    {
      "id": "IN_NO_AGENT_RERA",
      "stage": "pre_export",
      "level": "WARN",
      "when": "market=in AND compliance_context.is_brokered AND compliance_context.rera_agent is empty",
      "message": "Brokered listing without an agent RERA number. Add it or accept the risk."
    },
    {
      "id": "IN_AREA_BASIS",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "market=in AND any on-screen area figure without the label 'Carpet area' OR facts.area_basis != carpet AND the figure is used as price basis",
      "message": "Only carpet area may be used as the price basis in Indian advertising."
    },
    {
      "id": "IN_LUXURY_NO_CRITERIA",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "market=in AND 'luxury' appears in any copy AND facts.luxury_criteria is empty",
      "message": "'Luxury' without objective criteria."
    },
    {
      "id": "IN_RERA_BAND_MISSING",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "market=in AND compliance_context.rera_project set AND cta_card.compliance_lines lacks RERA number OR portal",
      "message": "RERA number and portal must be inside the frame, legible, not in the caption."
    },
    {
      "id": "US_FH_PHRASE",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "market=us AND any banned_phrases.us match in any card, caption or post text (exact) OR phrase_scan flags coded language",
      "message": "Fair Housing coded or preference language."
    },
    {
      "id": "US_SCHOOL_SUPERLATIVE",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "market=us AND a school is mentioned with any rating adjective",
      "message": "Schools may be named, never rated."
    },
    {
      "id": "US_ALTERED_NO_DISCLOSURE",
      "stage": "pre_generation",
      "level": "BLOCK",
      "when": "market=us AND hook.generation_path != free_2p5d AND (disclosure_overlay missing OR cta_card lacks the altered-image line)",
      "message": "Digitally altered exterior needs an on-screen label and an originals link (NAR SoP 12-5, CA AB 723)."
    },
    {
      "id": "US_ORIGINALS_URL",
      "stage": "pre_export",
      "level": "WARN",
      "when": "market=us AND compliance_context.originals_url is empty",
      "message": "No originals URL for the altered-image disclosure. Required in CA, best practice everywhere."
    },
    {
      "id": "US_EHO_LINE",
      "stage": "pre_export",
      "level": "WARN",
      "when": "market=us AND 'Equal Housing Opportunity' not in cta_card.compliance_lines",
      "message": "Equal Housing Opportunity line missing."
    },
    {
      "id": "US_BROKERAGE",
      "stage": "pre_export",
      "level": "WARN",
      "when": "market=us AND facts.brokerage empty",
      "message": "Brokerage name missing from CTA."
    },
    {
      "id": "HOOK_SOURCE_HAS_PEOPLE",
      "stage": "pre_generation",
      "level": "BLOCK",
      "when": "B0[hook.source_photo_id].flags.people_present",
      "message": "Hook source photo contains people."
    },
    {
      "id": "HOOK_CONCEPT_ASSET_FIT",
      "stage": "pre_generation",
      "level": "BLOCK",
      "when": "hook.scores.asset_fit == 0",
      "message": "Chosen hook needs an asset the pool lacks."
    },
    {
      "id": "HOOK_BLOCK_BUILD_TOWER",
      "stage": "pre_generation",
      "level": "BLOCK",
      "when": "hook.concept_id == block_build AND (property_type in [apartment, penthouse] OR observed floors > 3)",
      "message": "Block build fails on towers and multi-floor buildings at cheap engine rates."
    },
    {
      "id": "HOOK_FLYOVER_DEFAULT",
      "stage": "pre_generation",
      "level": "WARN",
      "when": "hook.concept_id == unveiling_flyover",
      "message": "Flyover reads as real footage. Heavy label required."
    },
    {
      "id": "NO_TRUTH_LOCK",
      "stage": "pre_generation",
      "level": "BLOCK",
      "when": "hook.truth_lock missing OR frames < 8",
      "message": "Every generated hook must end on the unaltered source photo."
    },
    {
      "id": "Q_FAIL_TWICE",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "Q1 or Q2 failed twice for this hook and no fallback was run",
      "message": "Hook QA failed twice. Switch to the fallback concept."
    },
    {
      "id": "INTERIOR_ALTERED",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "any interior shot source is a generated clip",
      "message": "Interiors must be the untouched photos with motion only."
    },
    {
      "id": "STAGING_UNLABELLED",
      "stage": "pre_export",
      "level": "WARN",
      "when": "listing_truth.flags.staging_suspected_any AND no 'Virtually staged' label in captions",
      "message": "Photos look virtually staged. Add the label or confirm they are real."
    },
    {
      "id": "CLAIM_UNPROVABLE",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "any card text or post_caption number or feature has no claims_trace entry OR format in [price_improved, sold_social_proof] without prior_price or sale_date",
      "message": "Every claim must trace to a listing fact."
    },
    {
      "id": "PEOPLE_IN_WALKTHROUGH",
      "stage": "pre_export",
      "level": "WARN",
      "when": "any selected shot photo has flags.people_present",
      "message": "People in a listing photo. Fair Housing imagery risk in US; misrepresentation risk anywhere."
    },
    {
      "id": "ASPECT_MASTER",
      "stage": "pre_export",
      "level": "WARN",
      "when": "primary master aspect != 9x16",
      "message": "Reels letterbox 16:9. 16:9 should be the derivative."
    },
    {
      "id": "LENGTH",
      "stage": "pre_export",
      "level": "WARN",
      "when": "total_length_s < 12 OR > 40",
      "message": "Outside the 12 to 40s window."
    },
    {
      "id": "MUSIC_UNLICENSED",
      "stage": "pre_export",
      "level": "BLOCK_PAID_WARN_ORGANIC",
      "when": "track_id not in licensed library",
      "message": "Track not in the licensed library."
    },
    {
      "id": "VARIANT_COLLISION",
      "stage": "pre_export",
      "level": "WARN",
      "when": "two reels share concept_id AND tier",
      "message": "Two reels will look the same."
    },
    {
      "id": "BUDGET",
      "stage": "pre_generation",
      "level": "WARN",
      "when": "sum(hook.est_cost.total_usd) > 3.0",
      "message": "Job estimate exceeds $3."
    },
    {
      "id": "SAFE_ZONE",
      "stage": "pre_export",
      "level": "BLOCK",
      "when": "any card bounding box outside safe_zone_9x16",
      "message": "Text inside the Reels UI overlay zone."
    }
  ],
  "job_defaults": {
    "reels_per_job": 3,
    "master_aspect": "9x16",
    "emit_16x9": true,
    "emit_silent_variant": true,
    "fps": 30,
    "master_size_9x16": "1080x1920",
    "master_size_16x9": "1920x1080",
    "hook_usable_s": 2.5,
    "truth_lock_frames": 15
  },
  "cost_reference_inr": {
    "text_node": 0.2,
    "vision_node": 0.5,
    "still": 4,
    "usd_inr": 84
  },
  "generation_paths": {
    "free_2p5d": {
      "desc": "canvas + ffmpeg only, no model call",
      "usd": 0
    },
    "reverse_conceal": {
      "desc": "VERIFIED Sept 2026. For any concept where a theatrical object HIDES the building. Generating from a still where the building is hidden makes the model invent a different building (proven failure). Instead: condition on the REAL photo and generate the concealment FORWARD, then reverse.",
      "steps": [
        "1. Crop the hero to 9:16 using B0 safe_crop_9x16 BEFORE any model call. Never let the model letterbox.",
        "2. H1 still: the END state (object fully covering the building), hero as reference. Prompt must list everything that stays unchanged: neighbours, vehicles, trees, power lines, sky, light direction.",
        "3. H2 clip: image = the REAL cropped hero (NOT the still). Prompt describes the object DESCENDING onto / covering the building. Static locked-off camera, explicit 'nothing else in the scene moves'.",
        "4. ffmpeg: reverse, fps=30.",
        "5. Truth lock: xfade 0.5s into a 1s hold of the untouched hero.",
        "6. Q2 on first/mid/last. The theatrical object in the mid frame is EXPECTED and is never a reject."
      ],
      "verified_on": "veo-3.1-lite-generate-001, 6s, 9:16, 720p, generateAudio false, personGeneration dont_allow",
      "verified_result": "2 of 2 runs preserved floors, front-window count, roof shape, colour, materials and the parked vehicle. Final frame pixel-matches the source.",
      "duration_s": 8,
      "usd_per_run": 0.4
    },
    "still_then_clip": {
      "desc": "DEPRECATED for concealment concepts. Produced a different building in testing. Keep only for concepts where the building stays visible throughout."
    },
    "clip_only": {
      "desc": "no still, video direct from the hero"
    }
  },
  "qa_rules": {
    "score_property_on": "final_frame_only",
    "score_scene_on": "all_frames",
    "scene_elements": [
      "people",
      "vehicles",
      "neighbouring_buildings",
      "trees",
      "road",
      "sky"
    ],
    "theatrical_object_is_never_a_reject": true,
    "count_tolerance": "counts drift between runs (8 vs 14 front windows on the same photo). Compare ref-vs-final WITHIN one QA call; never compare across runs or to a stored number.",
    "fail_conditions": [
      "final frame is not the same building",
      "final-frame count differs from the reference count in the same call",
      "a scene element was added or removed",
      "camera moved",
      "time of day or weather changed"
    ]
  },
  "render_constraints": {
    "no_drawtext": "Homebrew ffmpeg 9.0.1 ships without freetype, so drawtext is unavailable. All overlays are canvas-rendered PNG sequences composited with the overlay filter. This was already the design; the environment now enforces it.",
    "crop_before_generate": "Always crop to 9:16 before any image or video call. A 16:9 still sent to a 9:16 endpoint gets letterboxed and ~40 percent of the paid pixels are black bars.",
    "output_fps": 30,
    "veo_native_fps": 24
  }
}