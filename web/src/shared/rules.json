  "engine_bank": {
    "hailuo_02_standard": {
      "provider": "fal",
      "endpoint": "fal-ai/minimax/hailuo-02/standard/image-to-video",
      "usd_per_s": 0.045,
      "res": "768p",
      "durations": [
        6,
        10
      ],
      "aspects": [
        "9x16",
        "16x9"
      ],
      "upscale_needed": true
    },
    "ltx_2_fast": {
      "provider": "fal",
      "endpoint": "fal-ai/ltxv-2/image-to-video/fast",
      "usd_per_s": 0.04,
      "res": "1080p",
      "durations": [
        6,
        8,
        10
      ],
      "aspects": [
        "9x16",
        "16x9"
      ],
      "upscale_needed": false,
      "role": "draft"
    },
    "veo_3_1_lite": {
      "provider": "vertex",
      "endpoint": "veo-3.1-lite-generate-001",
      "usd_per_s": 0.05,
      "audio_bundled_on_vertex": true,
      "note": "Vertex bundles audio into the price. generateAudio:false does NOT reduce the rate. $0.03/s is the fal/Replicate audio-off rate, not Vertex. Verified against a real $0.40 charge for an 8s run.",
      "res": "720p",
      "durations_s": [
        4,
        6,
        8
      ],
      "last_frame_requires_duration_s": 8,
      "aspects": [
        "9x16",
        "16x9"
      ],
      "upscale_needed": true
    },
    "kling_2_5_turbo": {
      "provider": "fal",
      "endpoint": "fal-ai/kling-video/v2.5-turbo/pro/image-to-video",
      "usd_per_s": 0.07,
      "res": "1080p",
      "durations": [
        5,
        10
      ],
      "aspects": [
        "9x16",
        "16x9"
      ],
      "upscale_needed": false,
      "role": "fallback"
    },
    "nano_banana": {
      "provider": "vertex",
      "endpoint": "gemini-2.5-flash-image",
      "inr_per_image": 4,
      "role": "still"
    },
    "none": {
      "provider": "local",
      "usd_per_s": 0
    }
  },
  "engine_note": "Wan 2.5 removed: $0.05/s is its 480p rate. Seedance out of scope. Veo 3.1 Lite on Vertex is $0.05/s regardless of generateAudio; only fal/Replicate offer ~$0.03/s with audio off.",
