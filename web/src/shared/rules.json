      "id": "helicopter_drape",
      "label": "Small helicopter lifts a drape off the building",
      "scroll_stop": 0.95,
      "engine_survival": 0.9,
      "compliance_fit": 0.9,
      "needs": [
        "aerial_34|exterior_front"
      ],
      "default_path": "reverse_conceal",
      "default_engine": "hailuo_02_standard",
      "theatrical_objects": [
        "black or red drape",
        "small helicopter top of frame",
        "cables"
      ],
      "reference_reels": [
        "Wildcard",
        "hf_183734"
      ],
      "verified": true,
      "usable_window_s": {
        "start": 1.3,
        "end": 4.0
      },
      "notes": "Verified working. Cut the 1.3-4.0s window of the reversed clip: that is where the lift motion is. The first second is a near-static hang. Keep the helicopter small and high in frame; cables plus a dark shape read better than a rendered aircraft.",
      "duration_s": 8,
      "last_frame_still": true,
      "reverse_after_generate": true,
      "duration_note": "8s is forced by lastFrame on Vertex, not a creative choice."
    },
